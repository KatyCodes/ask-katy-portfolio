OPENAI_API_KEY=replace-with-a-project-key
OPENAI_MODEL=gpt-6.2-astra
ASK_KATY_ADMIN_PASSWORD=replace-with-a-long-unique-password
ASK_KATY_SESSION_SECRET=replace-with-at-least-32-random-characters
ASK_KATY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASK_KATY_COOKIE_SECURE=false
ASK_KATY_DATABASE_PATH=/absolute/private/path/ask-katy.private.db
ASK_KATY_CHAT_VISITOR_LIMIT=20
ASK_KATY_CHAT_VISITOR_WINDOW_SECONDS=600
ASK_KATY_CHAT_GLOBAL_LIMIT=120
ASK_KATY_CHAT_GLOBAL_WINDOW_SECONDS=3600
ASK_KATY_TRUST_PROXY=false
ASK_KATY_ERROR_LOG_PATH=/absolute/private/path/logs/ask-katy.errors.log
